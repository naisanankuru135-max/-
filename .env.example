# ------------------------------------------------------------
# ポイ帳 - AI スクリーンショット解析 プロバイダー設定
# ※ ブラウザ画面の「AI設定」からも入力・切替できます。
# ------------------------------------------------------------

# 優先プロバイダー（任意: auto | gemini | vertex_project | vertex_express | openai | anthropic | openai_compatible）
AI_PROVIDER="auto"

# 1. Gemini Developer API（APIキー）
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-4-hydrogen"

# 2. Vertex AI（GCP プロジェクト + ADC認証）
# ※ Gemini 4 Hydrogen を Vertex AI で使う場合はプロジェクト設定と location=global を推奨
#    認証は `gcloud auth application-default login` または GOOGLE_APPLICATION_CREDENTIALS を使用
# GOOGLE_GENAI_USE_ENTERPRISE="true"
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="global"
VERTEX_MODEL="gemini-4-hydrogen"
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# 3. Vertex AI Express Mode（APIキーのみ・プロジェクト不要）
# ※ Express Mode では Hydrogen が未対応の場合があるため既定モデルは gemini-3.8-flash
VERTEX_API_KEY=""
VERTEX_EXPRESS_MODEL="gemini-3.8-flash"

# 4. OpenAI API（Responses API）
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6.1-sol"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# 5. Anthropic Claude API（Messages API）
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# 6. OpenCode Zen API（無料ビジョンモデル＆GPT/Claude/Gemini統合ゲートウェイ）
OPENCODE_API_KEY=""
OPENCODE_MODEL="mimo-v2.6-flash-free"
# OPENCODE_BASE_URL="https://opencode.ai/zen/v1"

# 7. OpenCode Go API（月額定額プラン）
OPENCODE_GO_API_KEY=""
OPENCODE_GO_MODEL="deepseek-v4.1-flash"
# OPENCODE_GO_BASE_URL="https://opencode.ai/zen/go/v1"

# 8. OpenAI互換 API（OpenRouter / Groq / Ollama / LM Studio 等）
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_MODEL="google/gemini-4-hydrogen"
